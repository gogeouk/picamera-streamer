NAME=Picamera
PORT=8000
RESOLUTION=960x540

# Optional stream limits (defaults shown)
#MAX_STREAM_CLIENTS=8
#STREAM_CLIENT_TIMEOUT=20
#STREAM_STALL_TIMEOUT=15

# Live stream rate (defaults shown). Only affects what viewers are sent: the
# camera, the snapshots and the minute-by-minute captures are unchanged.
#STREAM_FPS=5
#STATS_FILE=stream-stats.json

# On-demand encoding (defaults shown)
#ENCODER_LINGER=20
#ENCODER_START_TIMEOUT=10
